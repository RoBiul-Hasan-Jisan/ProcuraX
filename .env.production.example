# Copy to .env (never commit it) and fill in. Used by docker-compose.prod.yml.

# --- Public addresses (the browser talks to the API directly) ---
FRONTEND_URL=https://app.example.com
NEXT_PUBLIC_API_URL=https://api.example.com/api/v1
# Containers bind to 127.0.0.1 by default so a reverse proxy can terminate TLS. Use 0.0.0.0 only if you know why.
PUBLISH_ADDRESS=127.0.0.1

# --- Firebase Admin (server side, secret). Keep the key on ONE line, single-quoted, with literal \n sequences. ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY='-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n'
BOOTSTRAP_ADMIN_EMAIL=

# --- Firebase web config (public by design; compiled into the browser bundle at build time) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Shared secret between backend and ML service. Generate:  openssl rand -hex 32 ---
ML_INTERNAL_KEY=

MAX_UPLOAD_MB=10

# --- Only for `--profile tools run --rm seed` (demo data). Firebase UIDs of demo accounts. ---
# DEMO_UID_SYSTEM_ADMIN=
# DEMO_UID_PROCUREMENT_MANAGER=
