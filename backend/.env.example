PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/steelprocure?replicaSet=rs0
FRONTEND_URL=http://localhost:3000
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep on one line, with literal \n sequences for newlines (handled in config/firebase.ts)
FIREBASE_PRIVATE_KEY=
ML_SERVICE_URL=http://localhost:8000
BOOTSTRAP_ADMIN_EMAIL=
ML_INTERNAL_KEY=change-me   # must equal ML_INTERNAL_KEY in ml/.env
ML_TIMEOUT_MS=20000

# Documents (Phase 6). Uploaded files are stored outside Git; keep this directory out of version control.
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10
